<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1716</NoWarn>

    <!-- Single SemVer for Host, Setup, and related packages. Widget Package.appxmanifest
         must use a four-part version; keep it in sync (Major.Minor.Patch.0). -->
    <Version>0.1.6</Version>
    <AssemblyVersion>0.1.6.0</AssemblyVersion>
    <FileVersion>0.1.6.0</FileVersion>
    <InformationalVersion>0.1.6</InformationalVersion>
    <Product>MistMapper</Product>
    <Company>MistMapper</Company>
  </PropertyGroup>
</Project>
