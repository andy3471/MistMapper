<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MistMapper.GameBarWidget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <!-- ════════ MAIN VIEW ════════ -->
        <ScrollViewer x:Name="MainView" Padding="16,14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Shared top: title + settings -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="MistMapper" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                        <TextBlock x:Name="StatusText" Text="Connecting…"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE713;" Click="Settings_Click"
                            Style="{StaticResource PillIconButtonStyle}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Settings"/>
                </Grid>

                <!-- Alert banner -->
                <Border x:Name="DepBanner"
                        Background="#66B33A3A" BorderBrush="#99E07070" BorderThickness="1"
                        Padding="14,12" CornerRadius="12" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="DepBannerText" Text="" Foreground="#FFFFD0D0" TextWrapping="Wrap" FontSize="13"/>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="GameIconBorder" Width="40" Height="40" CornerRadius="10"
                            Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                            Margin="0,0,12,0" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <Image x:Name="GameIconImage" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock x:Name="GameText" Grid.Column="1" Text=""
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>

                <Border x:Name="OverrideBanner"
                        Background="#662A5A7A" BorderBrush="#993D7EA6" BorderThickness="1"
                        Padding="14,12" CornerRadius="12" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="OverrideBannerText"
                               Text="Runtime: Xbox Gamepad while Game Bar is open."
                               Foreground="#FFB8D8F0" TextWrapping="Wrap" FontSize="13"/>
                </Border>

                <!-- VIEW | EDIT tabs (Y toggles — D-pad L/R is Game Bar widget switching) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="TabView" Content="VIEW" Click="ViewEditTab_Click" Tag="View"
                                Style="{StaticResource PillButtonStyle}"
                                Margin="0,0,8,0" Padding="22,10" FontSize="14"/>
                        <Button x:Name="TabEdit" Content="EDIT" Click="ViewEditTab_Click" Tag="Edit"
                                Style="{StaticResource PillButtonStyle}"
                                Margin="0,0,8,0" Padding="22,10" FontSize="14"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource HintChipStyle}"
                            ToolTipService.ToolTip="Y — switch View / Edit">
                        <TextBlock Text="Y" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </Border>
                </Grid>

                <!-- ──── VIEW PANEL ──── -->
                <StackPanel x:Name="ViewPanel">
                    <Grid x:Name="ViewControllerStrip" Margin="0,0,0,10" Visibility="Collapsed">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" ZoomMode="Disabled">
                            <StackPanel x:Name="ViewControllerTabs" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Grid>

                    <Border x:Name="NoControllerBanner"
                            Background="#662A5A7A" BorderBrush="#993D7EA6" BorderThickness="1"
                            Padding="20,24" CornerRadius="12" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="No controller connected"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock Text="Connect a Steam Controller to see the layout and remappings."
                                       FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="ControllerLayoutGrid">
                        <TextBlock x:Name="ViewLayoutTitle" Text="—" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ViewLayoutSubtitle" Text="" FontSize="13" Margin="0,2,0,4"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                        <TextBlock Text="Y to edit bindings"
                                   FontSize="12" Margin="0,0,0,12"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                        <!-- Callouts + large controller diagram (read-only overview) -->
                        <Grid MinHeight="380">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="150"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="*" MaxWidth="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="LeftLabelsPanel" Grid.Column="0"
                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border Grid.Column="1" CornerRadius="12"
                                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                    Padding="8" VerticalAlignment="Stretch">
                                <Image x:Name="ControllerOutlineImage" Source="Assets/controller-outline-sc2.png"
                                       Stretch="Uniform" Opacity="0.7"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       MinHeight="300"/>
                            </Border>
                            <StackPanel x:Name="RightLabelsPanel" Grid.Column="2"
                                        VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- ──── EDIT PANEL ──── -->
                <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                    <Grid x:Name="EditControllerStrip" Margin="0,0,0,12" Visibility="Collapsed">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" ZoomMode="Disabled">
                            <StackPanel x:Name="EditControllerTabs" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- Compact current-layout strip -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentLayoutTitle" Text="—" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="CurrentLayoutSubtitle" Text="" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button Content="Change…" Click="ChangeLayout_Click"
                                    Style="{StaticResource PillButtonStyle}"
                                    Padding="16,10" Margin="0,0,8,0" FontSize="13"
                                    ToolTipService.ToolTip="Load a different layout"/>
                            <Button Content="Save As…" Click="SaveAs_Click"
                                    Style="{StaticResource PillButtonStyle}"
                                    Padding="16,10" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Category tabs (B / X cycle — LB/RB switch Game Bar widgets) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource HintChipStyle}" Margin="0,0,10,0"
                                ToolTipService.ToolTip="X — previous category">
                            <TextBlock Text="X" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </Border>
                        <ScrollViewer x:Name="EditCategoryTabsScroller" Grid.Column="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled"
                                      ZoomMode="Disabled">
                            <StackPanel x:Name="EditCategoryTabs" Orientation="Horizontal"/>
                        </ScrollViewer>
                        <Border Grid.Column="2" Style="{StaticResource HintChipStyle}" Margin="10,0,0,0"
                                ToolTipService.ToolTip="B — next category">
                            <TextBlock Text="B" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="EditCategoryContent" Margin="0,0,0,8"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════ SETTINGS ════════ -->
        <Grid x:Name="SettingsView" Visibility="Collapsed" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="16,14,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" Click="SettingsBack_Click"
                        Style="{StaticResource PillIconButtonStyle}"
                        Margin="0,0,12,0" VerticalAlignment="Top"
                        ToolTipService.ToolTip="Back"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    <TextBlock Text="B to go back"
                               FontSize="13" Margin="0,2,0,0"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" Padding="16,8,16,16" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Controllers" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock x:Name="SettingsControllersEmpty"
                               Text="No controllers connected."
                               FontSize="13" Margin="0,0,0,8" Visibility="Collapsed"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <StackPanel x:Name="SettingsControllerList" Margin="0,0,0,8"/>
                    <TextBlock Text="Player order is the list order (1 = player 1). Editing shared bindings will ask whether to update every pad or only this one."
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                    <TextBlock Text="Bridge" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <ToggleSwitch x:Name="BridgeToggle" Header="MistMapper bridge"
                                  OffContent="Off" OnContent="On" Margin="0,0,0,20"
                                  Toggled="BridgeToggle_Toggled"/>

                    <TextBlock Text="Steam" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <ToggleSwitch x:Name="PauseSteamToggle" Header="Pause when Steam is running"
                                  OffContent="Off" OnContent="On" Margin="0,0,0,10"
                                  Toggled="PauseSteamToggle_Toggled"/>
                    <TextBlock Text="When Steam is open, MistMapper yields so Steam Input can take over the controller."
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ════════ LOAD LAYOUT (browse templates / your layouts) ════════ -->
        <Grid x:Name="BrowseLayoutView" Visibility="Collapsed" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="16,14,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" Click="BrowseLayoutBack_Click"
                        Style="{StaticResource PillIconButtonStyle}"
                        Margin="0,0,12,0" VerticalAlignment="Top"
                        ToolTipService.ToolTip="Back"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Load new layout" FontSize="20" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    <TextBlock Text="X / B switch sections · A to preview"
                               FontSize="13" Margin="0,2,0,0"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,6,16,12">
                <Button x:Name="BrowseTabTemplates" Content="TEMPLATES" Click="BrowseSection_Click" Tag="Templates"
                        Style="{StaticResource PillButtonStyle}"
                        Margin="0,0,8,0" Padding="18,10" FontSize="13"/>
                <Button x:Name="BrowseTabYours" Content="YOUR LAYOUTS" Click="BrowseSection_Click" Tag="Yours"
                        Style="{StaticResource PillButtonStyle}"
                        Margin="0,0,8,0" Padding="18,10" FontSize="13"/>
            </StackPanel>
            <ScrollViewer Grid.Row="2" Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="BrowseLayoutList"/>
            </ScrollViewer>
        </Grid>

        <!-- ════════ PREVIEW LAYOUT ════════ -->
        <Grid x:Name="PreviewLayoutView" Visibility="Collapsed" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="16,14,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" Click="PreviewLayoutBack_Click"
                        Style="{StaticResource PillIconButtonStyle}"
                        Margin="0,0,12,0" VerticalAlignment="Top"
                        ToolTipService.ToolTip="Back"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PreviewLayoutTitle" FontSize="20" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    <TextBlock x:Name="PreviewLayoutSubtitle" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" Padding="16,0,16,12" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Height="140" Margin="0,0,0,14" CornerRadius="12"
                            Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                        <Image x:Name="PreviewOutlineImage" Source="Assets/controller-outline-sc2.png"
                               Stretch="Uniform" Opacity="0.55"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               MaxHeight="120" MaxWidth="280"/>
                    </Border>
                    <StackPanel x:Name="PreviewCategorySummaries"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="B Back" Click="PreviewLayoutBack_Click"
                        Style="{StaticResource PillButtonStyle}"
                        HorizontalAlignment="Stretch" Padding="16,14"/>
                <Button Grid.Column="2" x:Name="ApplyLayoutButton" Content="A Apply Layout"
                        Click="ApplyLayout_Click" HorizontalAlignment="Stretch" Padding="16,14"
                        Style="{StaticResource PillAccentButtonStyle}"/>
            </Grid>
        </Grid>

        <!-- ════════ REMAP VIEW ════════ -->
        <Grid x:Name="RemapView" Visibility="Collapsed" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,14,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" Click="RemapCancel_Click"
                        Style="{StaticResource PillIconButtonStyle}"
                        Margin="0,0,12,0" VerticalAlignment="Top"
                        ToolTipService.ToolTip="Back"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="RemapTitle" FontSize="20" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    <TextBlock x:Name="RemapSubtitle"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               FontSize="13" Margin="0,2,0,0"/>
                    <TextBlock Text="X / B switch type · Back arrow to cancel"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="16,6,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource HintChipStyle}" Margin="0,0,10,0"
                        ToolTipService.ToolTip="X — previous type">
                    <TextBlock Text="X" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </Border>
                <ScrollViewer x:Name="RemapTabsScroller" Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled"
                              ZoomMode="Disabled">
                    <StackPanel x:Name="RemapTabsPanel" Orientation="Horizontal">
                        <Button x:Name="RemapTabGamepad" Content="GAMEPAD" Click="RemapTab_Click" Tag="Gamepad"
                                Style="{StaticResource PillButtonStyle}"
                                Margin="0,0,8,0" Padding="16,10" FontSize="13"/>
                        <Button x:Name="RemapTabKeyboard" Content="KEYBOARD" Click="RemapTab_Click" Tag="Keyboard"
                                Style="{StaticResource PillButtonStyle}"
                                Margin="0,0,8,0" Padding="16,10" FontSize="13"/>
                        <Button x:Name="RemapTabMouse" Content="MOUSE" Click="RemapTab_Click" Tag="Mouse"
                                Style="{StaticResource PillButtonStyle}"
                                Margin="0,0,8,0" Padding="16,10" FontSize="13"/>
                        <Button x:Name="RemapTabNone" Content="NONE" Click="RemapTab_Click" Tag="None"
                                Style="{StaticResource PillButtonStyle}"
                                Margin="0,0,8,0" Padding="16,10" FontSize="13"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Column="2" Style="{StaticResource HintChipStyle}" Margin="10,0,0,0"
                        ToolTipService.ToolTip="B — next type">
                    <TextBlock Text="B" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </Border>
            </Grid>

            <ScrollViewer x:Name="RemapContentScroller" Grid.Row="2" Padding="16,0,16,16"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          ZoomMode="Disabled">
                <StackPanel x:Name="RemapGrid"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
