<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MistMapper.GameBarWidget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF12141A">

    <Grid>
        <!-- ════════ MAIN VIEW ════════ -->
        <ScrollViewer x:Name="MainView" Padding="10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Shared top: title + bridge toggle -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="MistMapper" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                        <TextBlock x:Name="StatusText" Text="Connecting…"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="BridgeToggle" Grid.Column="1" OffContent="Off" OnContent="On"
                                  Toggled="BridgeToggle_Toggled" VerticalAlignment="Center"/>
                </Grid>

                <ToggleSwitch x:Name="PauseSteamToggle" Header="Pause when Steam is running"
                              OffContent="Off" OnContent="On" Margin="0,0,0,6"
                              Toggled="PauseSteamToggle_Toggled"/>

                <!-- Alert banner -->
                <Border x:Name="DepBanner" Background="#FF4A1A1A" BorderBrush="#FF8B3A3A" BorderThickness="1"
                        Padding="10,8" CornerRadius="6" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock x:Name="DepBannerText" Text="" Foreground="#FFFFD0D0" TextWrapping="Wrap" FontSize="12"/>
                </Border>

                <TextBlock x:Name="GameText" Text=""
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <Border x:Name="OverrideBanner" Background="#FF1A2A3A" BorderBrush="#FF3D7EA6" BorderThickness="1"
                        Padding="10,8" CornerRadius="6" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock x:Name="OverrideBannerText"
                               Text="Runtime: Xbox Gamepad while Game Bar is open."
                               Foreground="#FFB8D8F0" TextWrapping="Wrap" FontSize="12"/>
                </Border>

                <!-- VIEW | EDIT tabs -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Button x:Name="TabView" Content="VIEW" Click="ViewEditTab_Click" Tag="View"
                            Margin="0,0,4,0" Padding="16,8" FontSize="13"/>
                    <Button x:Name="TabEdit" Content="EDIT" Click="ViewEditTab_Click" Tag="Edit"
                            Margin="0,0,4,0" Padding="16,8" FontSize="13"/>
                </StackPanel>
                <TextBlock Text="LT / RT" FontSize="10" Margin="0,0,0,8"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                <!-- ──── VIEW PANEL ──── -->
                <StackPanel x:Name="ViewPanel">
                    <Border x:Name="NoControllerBanner" Background="#FF1A2A3A" BorderBrush="#FF3D7EA6" BorderThickness="1"
                            Padding="16,20" CornerRadius="6" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="No controller connected"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock Text="Connect a Steam Controller to see the layout and remappings."
                                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>

                    <Grid x:Name="ControllerLayoutGrid" Margin="0,0,0,8" Height="280">
                        <Image x:Name="ControllerOutlineImage" Source="Assets/controller-outline-sc2.png"
                               Stretch="Uniform" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               MaxHeight="260" MaxWidth="440"/>
                        <StackPanel x:Name="LeftLabelsPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="4,8,0,0" Width="140"/>
                        <StackPanel x:Name="RightLabelsPanel" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,8,4,0" Width="140"/>
                    </Grid>
                    <StackPanel x:Name="CategorySummaries" Margin="0,0,0,8"/>
                </StackPanel>

                <!-- ──── EDIT PANEL ──── -->
                <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                    <!-- Compact current-layout strip -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentLayoutTitle" Text="—" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="CurrentLayoutSubtitle" Text="" FontSize="11" Margin="0,1,0,0"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button Content="Change…" Click="ChangeLayout_Click"
                                    Padding="10,6" Margin="0,0,4,0" FontSize="12"
                                    ToolTipService.ToolTip="Load a different layout"/>
                            <Button Content="Save As…" Click="SaveAs_Click"
                                    Padding="10,6" Margin="0,0,4,0" FontSize="12"/>
                            <Button Content="Bind" Click="BindGame_Click"
                                    Padding="10,6" FontSize="12"
                                    ToolTipService.ToolTip="Bind this layout to the current game"/>
                        </StackPanel>
                    </Grid>

                    <!-- Category tabs -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <StackPanel x:Name="EditCategoryTabs" Orientation="Horizontal"/>
                    </StackPanel>
                    <TextBlock Text="LB / RB" FontSize="10" Margin="0,0,0,6"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                    <StackPanel x:Name="EditCategoryContent" Margin="0,0,0,8"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════ LOAD LAYOUT (browse templates / your layouts) ════════ -->
        <Grid x:Name="BrowseLayoutView" Visibility="Collapsed" Background="#FF12141A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="10,10,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" Click="BrowseLayoutBack_Click"
                        FontFamily="Segoe MDL2 Assets" FontSize="16"
                        Padding="10,8" Margin="0,0,10,0" VerticalAlignment="Top"
                        ToolTipService.ToolTip="Back"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Load new layout" FontSize="18" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    <TextBlock Text="LB / RB switch sections · A to preview"
                               FontSize="12" Margin="0,2,0,0"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,4,10,8">
                <Button x:Name="BrowseTabTemplates" Content="TEMPLATES" Click="BrowseSection_Click" Tag="Templates"
                        Margin="0,0,4,0" Padding="14,8" FontSize="13"/>
                <Button x:Name="BrowseTabYours" Content="YOUR LAYOUTS" Click="BrowseSection_Click" Tag="Yours"
                        Margin="0,0,4,0" Padding="14,8" FontSize="13"/>
            </StackPanel>
            <ScrollViewer Grid.Row="2" Padding="10,0,10,10" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="BrowseLayoutList"/>
            </ScrollViewer>
        </Grid>

        <!-- ════════ PREVIEW LAYOUT ════════ -->
        <Grid x:Name="PreviewLayoutView" Visibility="Collapsed" Background="#FF12141A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="10,10,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" Click="PreviewLayoutBack_Click"
                        FontFamily="Segoe MDL2 Assets" FontSize="16"
                        Padding="10,8" Margin="0,0,10,0" VerticalAlignment="Top"
                        ToolTipService.ToolTip="Back"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="PreviewLayoutTitle" FontSize="18" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    <TextBlock x:Name="PreviewLayoutSubtitle" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" Padding="10,0,10,10" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,8" Height="260">
                        <Image x:Name="PreviewOutlineImage" Source="Assets/controller-outline-sc2.png"
                               Stretch="Uniform" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               MaxHeight="240" MaxWidth="420"/>
                        <StackPanel x:Name="PreviewLeftLabels" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="4,8,0,0" Width="140"/>
                        <StackPanel x:Name="PreviewRightLabels" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,8,4,0" Width="140"/>
                    </Grid>
                    <StackPanel x:Name="PreviewCategorySummaries"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="10,0,10,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="B Back" Click="PreviewLayoutBack_Click"
                        HorizontalAlignment="Stretch" Padding="12,10"/>
                <Button Grid.Column="2" x:Name="ApplyLayoutButton" Content="A Apply Layout"
                        Click="ApplyLayout_Click" HorizontalAlignment="Stretch" Padding="12,10"
                        Style="{StaticResource AccentButtonStyle}"/>
            </Grid>
        </Grid>

        <!-- ════════ REMAP VIEW ════════ -->
        <Grid x:Name="RemapView" Visibility="Collapsed" Background="#FF12141A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10,10,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" Click="RemapCancel_Click"
                        FontFamily="Segoe MDL2 Assets" FontSize="16"
                        Padding="10,8" Margin="0,0,10,0" VerticalAlignment="Top"
                        ToolTipService.ToolTip="Back"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="RemapTitle" FontSize="18" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    <TextBlock x:Name="RemapSubtitle"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,4,10,8">
                <Button x:Name="RemapTabGamepad" Content="GAMEPAD" Click="RemapTab_Click" Tag="Gamepad"
                        Margin="0,0,4,0" Padding="14,8" FontSize="13"/>
                <Button x:Name="RemapTabKeyboard" Content="KEYBOARD" Click="RemapTab_Click" Tag="Keyboard"
                        Margin="0,0,4,0" Padding="14,8" FontSize="13"/>
                <Button x:Name="RemapTabMouse" Content="MOUSE" Click="RemapTab_Click" Tag="Mouse"
                        Margin="0,0,4,0" Padding="14,8" FontSize="13"/>
                <Button x:Name="RemapTabNone" Content="NONE" Click="RemapTab_Click" Tag="None"
                        Margin="0,0,4,0" Padding="14,8" FontSize="13"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" Padding="10,0,10,10" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RemapGrid"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
