<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MistMapper.GameBarWidget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF12141A">

    <Grid>
        <!-- ════════ MAIN VIEW ════════ -->
        <ScrollViewer x:Name="MainView" Padding="10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Shared top: title + bridge toggle -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="MistMapper" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                        <TextBlock x:Name="StatusText" Text="Connecting…"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="BridgeToggle" Grid.Column="1" OffContent="Off" OnContent="On"
                                  Toggled="BridgeToggle_Toggled" VerticalAlignment="Center"/>
                </Grid>

                <ToggleSwitch x:Name="PauseSteamToggle" Header="Pause when Steam is running"
                              OffContent="Off" OnContent="On" Margin="0,0,0,6"
                              Toggled="PauseSteamToggle_Toggled"/>

                <!-- Alert banner -->
                <Border x:Name="DepBanner" Background="#FF4A1A1A" BorderBrush="#FF8B3A3A" BorderThickness="1"
                        Padding="10,8" CornerRadius="6" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock x:Name="DepBannerText" Text="" Foreground="#FFFFD0D0" TextWrapping="Wrap" FontSize="12"/>
                </Border>

                <TextBlock x:Name="GameText" Text=""
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <Border x:Name="OverrideBanner" Background="#FF1A2A3A" BorderBrush="#FF3D7EA6" BorderThickness="1"
                        Padding="10,8" CornerRadius="6" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock x:Name="OverrideBannerText"
                               Text="Runtime: Xbox Gamepad while Game Bar is open."
                               Foreground="#FFB8D8F0" TextWrapping="Wrap" FontSize="12"/>
                </Border>

                <!-- VIEW | EDIT tabs -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="TabView" Content="VIEW" Click="ViewEditTab_Click" Tag="View"
                            Margin="0,0,4,0" Padding="16,8" FontSize="13"/>
                    <Button x:Name="TabEdit" Content="EDIT" Click="ViewEditTab_Click" Tag="Edit"
                            Margin="0,0,4,0" Padding="16,8" FontSize="13"/>
                </StackPanel>

                <!-- ──── VIEW PANEL ──── -->
                <StackPanel x:Name="ViewPanel">
                    <!-- Shown when no controller is connected -->
                    <Border x:Name="NoControllerBanner" Background="#FF1A2A3A" BorderBrush="#FF3D7EA6" BorderThickness="1"
                            Padding="16,20" CornerRadius="6" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="No controller connected"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock Text="Connect a Steam Controller to see the layout and remappings."
                                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Controller silhouette with mapping labels -->
                    <Grid x:Name="ControllerLayoutGrid" Margin="0,0,0,8" Height="280">
                        <Image x:Name="ControllerOutlineImage" Source="Assets/controller-outline-sc2.png"
                               Stretch="Uniform" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               MaxHeight="260" MaxWidth="440"/>
                        <StackPanel x:Name="LeftLabelsPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="4,8,0,0" Width="140"/>
                        <StackPanel x:Name="RightLabelsPanel" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,8,4,0" Width="140"/>
                    </Grid>
                    <StackPanel x:Name="CategorySummaries" Margin="0,0,0,8"/>
                </StackPanel>

                <!-- ──── EDIT PANEL ──── -->
                <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                    <!-- Profile selector -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- ContentDialog picker — ComboBox flyouts are unreliable with gamepad in Game Bar -->
                        <Button x:Name="ProfilesPickerButton" Click="ProfilesPicker_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,8" VerticalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="Profile" FontSize="11"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock x:Name="ProfilesPickerLabel" Text="—" FontSize="14"
                                           TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Content="Bind to game" Click="BindGame_Click"
                                VerticalAlignment="Bottom" Padding="12,6"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="New…" Click="NewProfile_Click" Padding="6,4"/>
                        <Button Grid.Column="2" Content="Duplicate" Click="DuplicateProfile_Click" Padding="6,4"/>
                        <Button Grid.Column="4" Content="Rename" Click="RenameProfile_Click" Padding="6,4"/>
                        <Button Grid.Column="6" Content="Delete" Click="DeleteProfile_Click" Padding="6,4"/>
                    </Grid>

                    <Button x:Name="LayoutsPickerButton" Click="LayoutsPicker_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Margin="0,0,0,8" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="Official layouts" FontSize="11"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            <TextBlock Text="Create profile from layout\u2026" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <!-- Category tabs -->
                    <StackPanel x:Name="EditCategoryTabs" Orientation="Horizontal" Margin="0,0,0,6"/>

                    <!-- Category content: input cards + category-specific settings -->
                    <StackPanel x:Name="EditCategoryContent" Margin="0,0,0,8"/>
                </StackPanel>

                <Button Content="Refresh" Click="RefreshButton_Click" HorizontalAlignment="Stretch" Opacity="0.7"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════ REMAP VIEW (Steam Input style full-page editor) ════════ -->
        <Grid x:Name="RemapView" Visibility="Collapsed" Background="#FF12141A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10,10,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" Click="RemapCancel_Click"
                        FontFamily="Segoe MDL2 Assets" FontSize="16"
                        Padding="10,8" Margin="0,0,10,0" VerticalAlignment="Top"
                        ToolTipService.ToolTip="Back"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="RemapTitle" FontSize="18" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    <TextBlock x:Name="RemapSubtitle"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,4,10,8">
                <Button x:Name="RemapTabGamepad" Content="GAMEPAD" Click="RemapTab_Click" Tag="Gamepad"
                        Margin="0,0,4,0" Padding="14,8" FontSize="13"/>
                <Button x:Name="RemapTabKeyboard" Content="KEYBOARD" Click="RemapTab_Click" Tag="Keyboard"
                        Margin="0,0,4,0" Padding="14,8" FontSize="13"/>
                <Button x:Name="RemapTabMouse" Content="MOUSE" Click="RemapTab_Click" Tag="Mouse"
                        Margin="0,0,4,0" Padding="14,8" FontSize="13"/>
                <Button x:Name="RemapTabNone" Content="NONE" Click="RemapTab_Click" Tag="None"
                        Margin="0,0,4,0" Padding="14,8" FontSize="13"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" Padding="10,0,10,10" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RemapGrid"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
