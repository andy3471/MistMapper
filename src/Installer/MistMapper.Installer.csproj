<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>MistMapper.Installer</RootNamespace>
    <AssemblyName>MistMapper-Setup</AssemblyName>
    <ApplicationIcon>..\Host\Assets\MistMapper.ico</ApplicationIcon>
    <Description>MistMapper setup - host, Game Bar widget, VIIPER, and startup</Description>
    <!-- Payload zip is optional at compile time; build-installer.ps1 embeds it. -->
    <DefineConstants Condition="Exists('Assets\payload.zip')">$(DefineConstants);HAS_PAYLOAD</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('Assets\payload.zip')">
    <EmbeddedResource Include="Assets\payload.zip" LogicalName="MistMapper.Installer.payload.zip" />
  </ItemGroup>

</Project>
